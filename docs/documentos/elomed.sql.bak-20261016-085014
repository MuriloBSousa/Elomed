-- ============================================================
-- ELOMED - BANCO DE DADOS FINAL
-- MySQL 8.0+ | InnoDB | utf8mb4
-- ============================================================

DROP DATABASE IF EXISTS elomed;
CREATE DATABASE elomed
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_unicode_ci;

USE elomed;

SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ============================================================
-- 01. USUÁRIOS E RBAC
-- ============================================================

CREATE TABLE tbl_usuario (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(150) NOT NULL,
    senha VARCHAR(255) NOT NULL,
    status ENUM('ativo','inativo','bloqueado') NOT NULL DEFAULT 'ativo',
    primeiro_acesso BOOLEAN NOT NULL DEFAULT TRUE,
    ultima_troca_senha DATETIME NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_usuario_email (email),
    KEY idx_usuario_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_roles (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    slug VARCHAR(50) NOT NULL,
    PRIMARY KEY (id),
    UNIQUE KEY uq_role_nome (nome),
    UNIQUE KEY uq_role_slug (slug)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_permissions (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL,
    modulo VARCHAR(50) NOT NULL DEFAULT 'geral',
    PRIMARY KEY (id),
    UNIQUE KEY uq_permission_nome (nome),
    UNIQUE KEY uq_permission_slug (slug)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_user_role (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    fk_role BIGINT UNSIGNED NOT NULL,
    PRIMARY KEY (id),
    UNIQUE KEY uq_user_role (fk_usuario, fk_role),
    KEY idx_user_role_role (fk_role),
    CONSTRAINT fk_user_role_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_user_role_role
        FOREIGN KEY (fk_role) REFERENCES tbl_roles(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_role_permission (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_role BIGINT UNSIGNED NOT NULL,
    fk_permission BIGINT UNSIGNED NOT NULL,
    PRIMARY KEY (id),
    UNIQUE KEY uq_role_permission (fk_role, fk_permission),
    KEY idx_role_permission_permission (fk_permission),
    CONSTRAINT fk_role_permission_role
        FOREIGN KEY (fk_role) REFERENCES tbl_roles(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_role_permission_permission
        FOREIGN KEY (fk_permission) REFERENCES tbl_permissions(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 02. PROFISSIONAIS
-- ============================================================

CREATE TABLE tbl_profissional (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    especialidade VARCHAR(150) NOT NULL,
    tempo_experiencia_anos TINYINT UNSIGNED NOT NULL DEFAULT 0,
    numero_registro VARCHAR(100) NOT NULL,
    limite_diario INT UNSIGNED NOT NULL DEFAULT 12,
    foto VARCHAR(255) NULL,
    pausa_inicio TIME NULL,
    pausa_fim TIME NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_profissional_usuario (fk_usuario),
    UNIQUE KEY uq_profissional_registro (numero_registro),
    CONSTRAINT fk_profissional_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT chk_profissional_limite
        CHECK (limite_diario > 0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 03. PACIENTES E DADOS CADASTRAIS NORMALIZADOS
-- ============================================================

CREATE TABLE tbl_paciente (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    data_nascimento DATE NOT NULL,
    cpf CHAR(11) NULL,
    rg VARCHAR(20) NULL,
    sexo ENUM('feminino','masculino','nao_informado') NOT NULL DEFAULT 'nao_informado',
    estado_civil ENUM('solteiro','casado','divorciado','viuvo','uniao_estavel','separado','nao_informado') NOT NULL DEFAULT 'nao_informado',
    foto VARCHAR(255) NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_paciente_usuario (fk_usuario),
    UNIQUE KEY uq_paciente_cpf (cpf),
    CONSTRAINT fk_paciente_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_telefone (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    telefone VARCHAR(20) NOT NULL,
    tipo ENUM('principal','secundario','comercial') NOT NULL DEFAULT 'principal',
    PRIMARY KEY (id),
    KEY idx_telefone_usuario (fk_usuario),
    CONSTRAINT fk_telefone_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_endereco (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    logradouro VARCHAR(150) NOT NULL,
    numero VARCHAR(20) NOT NULL,
    complemento VARCHAR(100) NULL,
    bairro VARCHAR(100) NOT NULL,
    cep CHAR(8) NOT NULL,
    cidade VARCHAR(100) NOT NULL,
    uf CHAR(2) NOT NULL,
    principal BOOLEAN NOT NULL DEFAULT TRUE,
    PRIMARY KEY (id),
    KEY idx_endereco_usuario (fk_usuario),
    CONSTRAINT fk_endereco_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_contato_emergencia (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_paciente BIGINT UNSIGNED NOT NULL,
    nome VARCHAR(100) NOT NULL,
    parentesco VARCHAR(50) NULL,
    telefone VARCHAR(20) NOT NULL,
    observacao VARCHAR(255) NULL,
    principal BOOLEAN NOT NULL DEFAULT TRUE,
    PRIMARY KEY (id),
    KEY idx_emergencia_paciente (fk_paciente),
    CONSTRAINT fk_emergencia_paciente
        FOREIGN KEY (fk_paciente) REFERENCES tbl_paciente(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_convenio (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    nome_operadora VARCHAR(100) NOT NULL,
    registro_ans VARCHAR(20) NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE,
    PRIMARY KEY (id),
    UNIQUE KEY uq_convenio_nome (nome_operadora)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_paciente_convenio (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_paciente BIGINT UNSIGNED NOT NULL,
    fk_convenio BIGINT UNSIGNED NOT NULL,
    numero_carteirinha VARCHAR(50) NOT NULL,
    validade DATE NULL,
    titular_nome VARCHAR(100) NULL,
    ativo BOOLEAN NOT NULL DEFAULT TRUE,
    PRIMARY KEY (id),
    UNIQUE KEY uq_paciente_convenio (fk_paciente, fk_convenio, numero_carteirinha),
    KEY idx_pc_convenio (fk_convenio),
    CONSTRAINT fk_pc_paciente
        FOREIGN KEY (fk_paciente) REFERENCES tbl_paciente(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_pc_convenio
        FOREIGN KEY (fk_convenio) REFERENCES tbl_convenio(id)
        ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_anamnese (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_paciente BIGINT UNSIGNED NOT NULL,
    alergias TEXT NULL,
    doencas_previas TEXT NULL,
    medicamentos_uso TEXT NULL,
    cirurgias TEXT NULL,
    observacoes TEXT NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_anamnese_paciente (fk_paciente),
    CONSTRAINT fk_anamnese_paciente
        FOREIGN KEY (fk_paciente) REFERENCES tbl_paciente(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 04. TRIAGEM (Criada antes de agendamento)
-- ============================================================

CREATE TABLE tbl_triagem (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_paciente BIGINT UNSIGNED NOT NULL,
    fk_profissional BIGINT UNSIGNED NULL,
    fk_analisado_por BIGINT UNSIGNED NULL,
    nome_solicitante VARCHAR(150) NOT NULL,
    status ENUM('pendente','aprovada','recusada') NOT NULL DEFAULT 'pendente',
    classificacao ENUM('vermelho','amarelo','verde') NULL,
    ia_classificacao ENUM('vermelho','amarelo','verde') NULL,
    ia_justificativa_classificacao VARCHAR(500) NULL,
    ia_perfil_recomendado ENUM('medico','enfermeiro') NULL,
    ia_justificativa_perfil VARCHAR(500) NULL,
    ia_profissional_sugerido BIGINT UNSIGNED NULL,
    ia_modelo VARCHAR(100) NULL,
    ia_analisada_em DATETIME NULL,
    queixa_principal TEXT NULL,
    descricao_sintomas TEXT NULL,
    data_inicio_sintomas DATE NULL,
    justificativa_reprovacao TEXT NULL,
    justificativa_encaminhamento VARCHAR(500) NULL,
    data_aprovacao DATETIME NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    KEY idx_triagem_paciente_status (fk_paciente, status),
    KEY idx_triagem_profissional (fk_profissional),
    KEY idx_triagem_analisado (fk_analisado_por),
    KEY idx_triagem_ia_profissional (ia_profissional_sugerido),
    CONSTRAINT fk_triagem_paciente
        FOREIGN KEY (fk_paciente) REFERENCES tbl_paciente(id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_triagem_profissional
        FOREIGN KEY (fk_profissional) REFERENCES tbl_profissional(id)
        ON DELETE SET NULL ON UPDATE CASCADE,
    CONSTRAINT fk_triagem_analisado
        FOREIGN KEY (fk_analisado_por) REFERENCES tbl_profissional(id)
        ON DELETE SET NULL ON UPDATE CASCADE,
    CONSTRAINT fk_triagem_ia_profissional
        FOREIGN KEY (ia_profissional_sugerido) REFERENCES tbl_profissional(id)
        ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 05. AGENDAMENTO
-- ============================================================

CREATE TABLE tbl_agendamento (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    data_hora_inicio DATETIME NOT NULL,
    data_hora_fim DATETIME NOT NULL,
    status ENUM('agendado','em_andamento','pendente','concluido','cancelado','ausente') NOT NULL DEFAULT 'pendente',
    vezes_reagendado TINYINT UNSIGNED NOT NULL DEFAULT 0,
    duracao_minutos SMALLINT UNSIGNED NOT NULL DEFAULT 30,
    justificativa_cancelamento TEXT NULL,
    classificacao_ia ENUM('vermelho','amarelo','verde') NULL,
    justificativa_classificacao_ia TEXT NULL,
    profissional_recomendado_ia VARCHAR(150) NULL,
    justificativa_recomendacao_ia TEXT NULL,
    classificacao_final ENUM('vermelho','amarelo','verde') NULL,
    justificativa_encaminhamento TEXT NULL,
    modelo_ia VARCHAR(100) NULL,
    data_analise_ia DATETIME NULL,
    fk_profissional BIGINT UNSIGNED NOT NULL,
    fk_profissional_origem BIGINT UNSIGNED NULL,
    fk_paciente BIGINT UNSIGNED NOT NULL,
    fk_triagem BIGINT UNSIGNED NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_agendamento_triagem (fk_triagem),
    KEY idx_agendamento_data_status (data_hora_inicio, status),
    KEY idx_agendamento_profissional (fk_profissional, data_hora_inicio),
    KEY idx_agendamento_paciente (fk_paciente, data_hora_inicio),
    KEY idx_agendamento_origem (fk_profissional_origem),
    CONSTRAINT fk_agendamento_profissional
        FOREIGN KEY (fk_profissional) REFERENCES tbl_profissional(id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_agendamento_profissional_origem
        FOREIGN KEY (fk_profissional_origem) REFERENCES tbl_profissional(id)
        ON DELETE SET NULL ON UPDATE CASCADE,
    CONSTRAINT fk_agendamento_paciente
        FOREIGN KEY (fk_paciente) REFERENCES tbl_paciente(id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_agendamento_triagem
        FOREIGN KEY (fk_triagem) REFERENCES tbl_triagem(id)
        ON DELETE SET NULL ON UPDATE CASCADE,
    CONSTRAINT chk_agendamento_periodo
        CHECK (data_hora_fim > data_hora_inicio),
    CONSTRAINT chk_agendamento_duracao
        CHECK (duracao_minutos > 0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 06. ATENDIMENTO E FEEDBACK
-- ============================================================

CREATE TABLE tbl_atendimento (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_agendamento BIGINT UNSIGNED NOT NULL,
    fk_profissional BIGINT UNSIGNED NOT NULL,
    horario_inicio DATETIME NOT NULL,
    horario_fim DATETIME NULL,
    status ENUM('agendado','em_andamento','concluido','cancelado','ausente') NOT NULL DEFAULT 'agendado',
    observacoes TEXT NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_atendimento_agendamento (fk_agendamento),
    KEY idx_atendimento_profissional (fk_profissional, horario_inicio),
    CONSTRAINT fk_atendimento_agendamento
        FOREIGN KEY (fk_agendamento) REFERENCES tbl_agendamento(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_atendimento_profissional
        FOREIGN KEY (fk_profissional) REFERENCES tbl_profissional(id)
        ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_feedback (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_atendimento BIGINT UNSIGNED NOT NULL,
    fk_profissional BIGINT UNSIGNED NOT NULL,
    fk_paciente BIGINT UNSIGNED NOT NULL,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    nota TINYINT UNSIGNED NOT NULL,
    comentario VARCHAR(500) NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_feedback_atendimento (fk_atendimento),
    KEY idx_feedback_profissional (fk_profissional),
    KEY idx_feedback_paciente (fk_paciente),
    KEY idx_feedback_criado (criado_em),
    CONSTRAINT chk_feedback_nota CHECK (nota BETWEEN 0 AND 5),
    CONSTRAINT fk_feedback_atendimento
        FOREIGN KEY (fk_atendimento) REFERENCES tbl_atendimento(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_feedback_profissional
        FOREIGN KEY (fk_profissional) REFERENCES tbl_profissional(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_feedback_paciente
        FOREIGN KEY (fk_paciente) REFERENCES tbl_paciente(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_feedback_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 07. PRONTUÁRIO
-- ============================================================

CREATE TABLE tbl_prontuario (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_atendimento BIGINT UNSIGNED NOT NULL,
    queixa_principal TEXT NULL,
    historico_medico TEXT NULL,
    sinais_vitais JSON NULL,
    analise_ia JSON NULL,
    diagnostico_final TEXT NULL,
    conduta_medica TEXT NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_prontuario_atendimento (fk_atendimento),
    CONSTRAINT fk_prontuario_atendimento
        FOREIGN KEY (fk_atendimento) REFERENCES tbl_atendimento(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_prontuario_visualizacao (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_prontuario BIGINT UNSIGNED NOT NULL,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    KEY idx_pv_prontuario (fk_prontuario),
    KEY idx_pv_usuario (fk_usuario),
    CONSTRAINT fk_pv_prontuario
        FOREIGN KEY (fk_prontuario) REFERENCES tbl_prontuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_pv_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 08. PROTOCOLOS MÉDICOS
-- ============================================================

CREATE TABLE tbl_protocolos (
    id INT UNSIGNED NOT NULL AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    descricao TEXT NULL,
    categoria ENUM('cronico','agudo','investigacao','acompanhamento') NOT NULL DEFAULT 'agudo',
    ativo BOOLEAN NOT NULL DEFAULT TRUE,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_protocolo_nome (nome)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_perguntas_protocolo (
    id INT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_protocolo INT UNSIGNED NOT NULL,
    ordem INT UNSIGNED NOT NULL DEFAULT 1,
    tipo ENUM('texto','numero','select','radio','checkbox','textarea') NOT NULL DEFAULT 'texto',
    pergunta TEXT NOT NULL,
    placeholder VARCHAR(255) NULL,
    obrigatorio BOOLEAN NOT NULL DEFAULT FALSE,
    opcoes JSON NULL,
    condicional JSON NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_pergunta_ordem (fk_protocolo, ordem),
    KEY idx_pergunta_protocolo (fk_protocolo),
    CONSTRAINT fk_pergunta_protocolo
        FOREIGN KEY (fk_protocolo) REFERENCES tbl_protocolos(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE tbl_resposta_protocolo (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_triagem BIGINT UNSIGNED NOT NULL,
    fk_pergunta INT UNSIGNED NOT NULL,
    resposta JSON NOT NULL,
    respondido_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    UNIQUE KEY uq_resposta_triagem_pergunta (fk_triagem, fk_pergunta),
    KEY idx_resposta_pergunta (fk_pergunta),
    CONSTRAINT fk_resposta_triagem
        FOREIGN KEY (fk_triagem) REFERENCES tbl_triagem(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_resposta_pergunta
        FOREIGN KEY (fk_pergunta) REFERENCES tbl_perguntas_protocolo(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 09. LEMBRETES
-- ============================================================

CREATE TABLE tbl_lembrete (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_agendamento BIGINT UNSIGNED NOT NULL,
    mensagem VARCHAR(255) NOT NULL,
    status ENUM('enviado','pendente','falha') NOT NULL DEFAULT 'pendente',
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    enviado_em TIMESTAMP NULL,
    PRIMARY KEY (id),
    KEY idx_lembrete_agendamento (fk_agendamento),
    KEY idx_lembrete_status (status),
    CONSTRAINT fk_lembrete_agendamento
        FOREIGN KEY (fk_agendamento) REFERENCES tbl_agendamento(id)
        ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 10. AUDITORIA
-- ============================================================

CREATE TABLE tbl_auditoria (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NULL,
    usuario_nome VARCHAR(100) NULL,
    usuario_perfil VARCHAR(100) NULL,
    acao VARCHAR(100) NOT NULL,
    descricao VARCHAR(500) NOT NULL,
    propriedades JSON NULL,
    ip VARCHAR(45) NULL,
    data_hora DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    KEY idx_auditoria_data (data_hora),
    KEY idx_auditoria_acao (acao),
    KEY idx_auditoria_usuario (fk_usuario),
    CONSTRAINT fk_auditoria_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE SET NULL ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
-- 11. USO DE IA
-- ============================================================

CREATE TABLE tbl_uso_ia (
    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
    fk_usuario BIGINT UNSIGNED NOT NULL,
    modelo VARCHAR(100) NOT NULL,
    quantidade_consultas INT UNSIGNED NOT NULL DEFAULT 1,
    data_consulta DATE NOT NULL,
    criado_em TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    KEY idx_uso_ia_usuario_data (fk_usuario, data_consulta),
    CONSTRAINT fk_uso_ia_usuario
        FOREIGN KEY (fk_usuario) REFERENCES tbl_usuario(id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT chk_uso_ia_quantidade CHECK (quantidade_consultas > 0)
