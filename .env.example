# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=elomed
DB_USER=root
DB_PASS=

# Configurações de Sessão
SESSION_NAME=elomed_session
SESSION_LIFETIME=3600
SESSION_SECURE=false
SESSION_DOMAIN=
SESSION_SAMESITE=Lax

# Configurações de API de IA
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=

# Login com Google (OAuth 2.0) - preencha para ativar o botão "Entrar com Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/elomed/public/login/google_callback

# Configurações de Cache
CACHE_ENABLED=true
CACHE_DRIVER=file

# Configurações de Logging
LOGGING_ENABLED=true
LOG_LEVEL=info

# Configurações da Aplicação
APP_ENV=development
APP_DEBUG=true

# Hosts aceitos para montar o BASE_URL (proteção contra host header injection).
# Lista separada por vírgula. Use * para subdomínios: *.elomed.com.br
# Vazio = aceita apenas localhost/127.0.0.1/::1 (comportamento de desenvolvimento).
ALLOWED_HOSTS=

# Configurações de Email (Opcional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@elomed.com
MAIL_FROM_NAME=EloMed

# Notificacoes WhatsApp (Evolution API)
# Preencha URL, token (apikey) e instancia da sua Evolution API para ativar.
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=http://localhost
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE=
